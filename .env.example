# Copy to .env.local. Add the key locally; never paste it into chat.
# Server-side only. Never rename this to NEXT_PUBLIC_MODEL_API_KEY.
MODEL_API_KEY=
# Unified Copilot configuration (lib/copilot/config.ts is the only reader).
# ARIQ_COPILOT_ENABLED is the primary flag; ARIQ_AI_ENABLED is a legacy alias.
ARIQ_COPILOT_ENABLED=false
META_MODEL=muse-spark-1.3
# Hard application-level budget enforced by the CopilotBudget Durable Object.
COPILOT_BUDGET_TOTAL_USD=5
COPILOT_BUDGET_DAILY_USD=1
# Contributor mode (Meta may train on prompts) is OFF unless explicitly
# approved for non-sensitive demo data AND COPILOT_MODEL names it:
# COPILOT_ALLOW_CONTRIBUTOR=false
# COPILOT_MODEL=muse-spark-1.3
# This template does not enable API calls or enforce a spending cap.
