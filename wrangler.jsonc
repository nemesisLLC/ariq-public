{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ariq-private",
  "// account_id": "set via wrangler login or CLOUDFLARE_ACCOUNT_ID",
  "main": "cloudflare/app.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "ratelimits": [{"name":"API_RATE_LIMITER","namespace_id":"28361029","simple":{"limit":60,"period":60}}],
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "vars": {
    "ARIQ_COPILOT_ENABLED": "true",
    "META_MODEL": "muse-spark-1.3",
    "COPILOT_BUDGET_TOTAL_USD": "5",
    "COPILOT_BUDGET_DAILY_USD": "1"
  },
  "durable_objects": {
    "bindings": [
      { "name": "COPILOT_BUDGET", "class_name": "CopilotBudgetDO" }
    ]
  },
  "migrations": [
    { "tag": "v1-copilot-budget", "new_sqlite_classes": ["CopilotBudgetDO"] }
  ],
  "triggers": {
    "crons": [
      "15 */6 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}

